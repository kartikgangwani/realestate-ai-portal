# ── Database (Railway provides this from its PostgreSQL service) ──
DATABASE_URL=postgresql://user:password@host:5432/realestate_ai

# ── Mode ──────────────────────────────────────────────────────────
# TEST  = safe: nothing ever leaves the server (dry runs only)
# LIVE  = real sends. Requires ALLOW_LIVE=YES-I-UNDERSTAND (see GO-LIVE-FOR-ME.md)
APP_MODE=TEST
ALLOW_LIVE=

# Keep the approval queue ON — a human approves every outbound message.
APPROVAL_REQUIRED=true
# Optional: send approved messages automatically without a second click (LIVE only)
AUTO_SEND=false

# ── Admin login ───────────────────────────────────────────────────
ADMIN_USERNAME=portaladmin
ADMIN_PASSWORD=replace-with-a-unique-14-plus-character-password
SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-chars

# ── Meta / WhatsApp Cloud API (developers.facebook.com → your app) ─
META_APP_SECRET=
GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=make-up-a-random-string
# Optional override (used for local mocks/tests):
# WHATSAPP_API_BASE=https://graph.facebook.com

# ── Instagram Messaging (Instagram Login path) ────────────────────
IG_USER_ID=
IG_TOKEN=
# IG_API_BASE=https://graph.facebook.com

# ── AI agent (LLM) ────────────────────────────────────────────────
# provider: mock | openai | anthropic   (mock = no key needed, offline templated drafts)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ── Lead ingest (portal emails / webhooks -> CRM) ─────────────────
# Koi random secret banao. Portal email ko yahan POST karo (X-Ingest-Token header).
# Gmail Apps Script / Zapier setup: LEAD-INGEST.md dekho
LEAD_INGEST_TOKEN=

# ── Property photos + Google location pin ────────────────────────────────────
# Public https address of this deployment. WhatsApp/Instagram fetch property
# photos from <PUBLIC_BASE_URL>/media/<id>, so set this to your Railway domain
# (example: https://realestate-ai-portal-production.up.railway.app).
# TEST mode works without it; LIVE photo sending requires it.
PUBLIC_BASE_URL=

# Optional: your own WhatsApp number (digits only, country code ke saath) —
# public property page par "WhatsApp par baat karein" button dikhega.
# Example: 919876543210
PUBLIC_CONTACT_WHATSAPP=

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_SSL=false
